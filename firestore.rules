rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // ADMIN CONFIGURATION
    // ============================================
    // STEP 1: Login to your app with asgardduels@gmail.com
    // STEP 2: Go to Firebase Console > Authentication > Users
    // STEP 3: Copy your UID from the list
    // STEP 4: Replace 'YOUR_ADMIN_UID_HERE' below with your actual UID
    // STEP 5: Publish these rules
    // ============================================
    
    // Helper function to check if user is super admin BY UID
    // This is more reliable than email-based checks with OAuth providers
    function isSuperAdminByUid() {
      return request.auth != null && 
             request.auth.uid in [
               'wgPwCyYGuYUAokSklV1LNsjCrGA3',  // Replace with your actual UID!
               // Add more admin UIDs here if needed, comma-separated
             ];
    }
    
    // Fallback: Check by email (may not work with all OAuth providers)
    function isSuperAdminByEmail() {
      return request.auth != null && 
             (request.auth.token.email == 'asgardduels@gmail.com' || 
              request.auth.token.email.lower() == 'asgardduels@gmail.com');
    }

    // New helper: Dynamic Super Admin check via Database Role
    function isDynamicSuperAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'superadmin';
    }

    
    // Combined check - try both methods
    function isSuperAdmin() {
      return isSuperAdminByUid() || isSuperAdminByEmail() || isDynamicSuperAdmin();
    }
    
    // Check if user has staff privileges (Super Admin OR assigned Admin role)
    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['admin', 'senior_admin', 'superadmin']
      );
    }

    
    // Check if user is a Games Manager (specifically for mini-games)
    function isGamesManager() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'games_manager';
    }

    // Check if user is a Merchant (specifically for shop management)
    function isMerchant() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'merchant';
    }

    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper function to get user role in a draft safely
    function getRole(draftId) {
      let draft = get(/databases/$(database)/documents/drafts/$(draftId)).data;
      return (isAuthenticated() && draft.permissions != null && request.auth.uid in draft.permissions) 
             ? draft.permissions[request.auth.uid] 
             : 'spectator';
    }

    // Check if user is the draft creator or has admin role in that draft
    function isDraftAdmin(draftId) {
      let draft = get(/databases/$(database)/documents/drafts/$(draftId)).data;
      return isSuperAdmin() || 
             getRole(draftId) == 'admin' || 
             (request.auth != null && draft.createdBy == request.auth.uid);
    }

    // Helper function to check if user is truly logged in (not anonymous)
    function isRealUser() {
      return request.auth != null && 
             (!('anonymous' in request.auth.token) || request.auth.token.anonymous == false);
    }

    // Helper function to check if user has a linked account
    function isLinked() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('auroryPlayerId', null) != null;
    }

    // Helper to verify raffle fee increment (moved from inline to resolve 'let' error)
    function checkRaffleFee(resourceData, requestResourceData) {
      let currency = resourceData.get('entryFeeCurrency', 'AURY');
      let multiplier = currency == 'USDC' ? 1000000 : (currency == 'Valcoins' ? 1 : 1000000000);
      let entryFee = resourceData.get('isFree', true) ? 0 : resourceData.get('entryFee', 0);
      let feeSmallestUnit = int(entryFee * multiplier);
      return requestResourceData.totalFeesCollected == resourceData.get('totalFeesCollected', 0) + feeSmallestUnit;
    }
    
    // =============================================
    // DRAFTS / TOURNAMENTS
    // =============================================
    match /drafts/{draftId} {
      // Anyone can read drafts (public)
      allow read: if true;
      
      // Authenticated users can create drafts
      allow create: if isAuthenticated();
      
      // Authenticated users can update drafts
      allow update: if isAuthenticated() && (
        // 1. Admins/SuperAdmins/Draft Creators can update everything
        isDraftAdmin(draftId) || 
        (
          // 2. Participants can update their own team's picks during active draft
          // Allow picking (status remains same or transitions to completed)
          (getRole(draftId) == 'A' && request.resource.data.teamA != resource.data.teamA && (request.resource.data.status == resource.data.status || request.resource.data.status == 'completed')) ||
          (getRole(draftId) == 'B' && request.resource.data.teamB != resource.data.teamB && (request.resource.data.status == resource.data.status || request.resource.data.status == 'completed')) ||
          // 2b. Allow banning (mode4 - ban fields change during active)
          (getRole(draftId) == 'A' && request.resource.data.teamABans != resource.data.teamABans && (request.resource.data.status == resource.data.status || request.resource.data.status == 'completed')) ||
          (getRole(draftId) == 'B' && request.resource.data.teamBBans != resource.data.teamBBans && (request.resource.data.status == resource.data.status || request.resource.data.status == 'completed')) ||
          // 2c. Allow participants to update game state during active phase
          // (lock confirmation, phase transitions, 1v1 lock picks, preparation state)
          (getRole(draftId) in ['A', 'B'] && resource.data.status == 'active' && (request.resource.data.status == 'active' || request.resource.data.status == 'completed')) ||
          // 3. Allow pre-draft and transition phases (joining, leaving, starting, shuffling)
          (resource.data.status in ['waiting', 'assignment', 'coinFlip', 'poolShuffle']) ||
          // 4. Allow concession in 1v1 matches (participants can only concede for themselves)
          (resource.data.draftType in ['mode3', 'mode4'] && 
           (resource.data.status == 'active' || resource.data.status == 'completed') && 
           request.resource.data.status == 'completed' && 
           request.resource.data.concededBy == getRole(draftId) &&
           !('concededBy' in resource.data)) ||
          // 5. Allow voting for any viewer
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']))
        )
      );
      
      // Only admins and creators can delete drafts
      allow delete: if isDraftAdmin(draftId);
      
      // -----------------------------------------
      // TEAM A CHAT SUBCOLLECTION
      // -----------------------------------------
      match /chatA/{messageId} {
        // Only Team A members can read Team A chat, but admins can read all
        allow read: if isAuthenticated() && 
                       (getRole(draftId) in ['A', 'admin'] || isSuperAdmin());
        
        // Members of Team A or Admins can send messages
        allow create: if isAuthenticated() && 
                         (getRole(draftId) in ['A', 'admin'] || isSuperAdmin()) &&
                         request.resource.data.senderUid == request.auth.uid;
        
        // Members of Team A or Admins can update messages (for reactions)
        allow update: if isAuthenticated() && 
                         (getRole(draftId) in ['A', 'admin'] || isSuperAdmin());
        
        // Admins and creators can delete messages
        allow delete: if isDraftAdmin(draftId);
      }
      
      // -----------------------------------------
      // TEAM B CHAT SUBCOLLECTION
      // -----------------------------------------
      match /chatB/{messageId} {
        // Only Team B members can read Team B chat, but admins can read all
        allow read: if isAuthenticated() && 
                       (getRole(draftId) in ['B', 'admin'] || isSuperAdmin());
        
        // Members of Team B or Admins can send messages
        allow create: if isAuthenticated() && 
                         (getRole(draftId) in ['B', 'admin'] || isSuperAdmin()) &&
                         request.resource.data.senderUid == request.auth.uid;
        
        // Members of Team B or Admins can update messages (for reactions)
        allow update: if isAuthenticated() && 
                         (getRole(draftId) in ['B', 'admin'] || isSuperAdmin());
        
        // Admins and creators can delete messages
        allow delete: if isDraftAdmin(draftId);
      }
      
      match /chatAll/{messageId} {
        // Only participants (A, B, admin) can read
        allow read: if isAuthenticated() && 
                       (getRole(draftId) in ['A', 'B', 'admin'] || isSuperAdmin());
        
        // Only participants can send messages
        allow create: if isAuthenticated() && 
                         (getRole(draftId) in ['A', 'B', 'admin'] || isSuperAdmin()) &&
                         request.resource.data.senderUid == request.auth.uid;
        
        // Participants can update messages (for reactions)
        allow update: if isAuthenticated() && 
                         (getRole(draftId) in ['A', 'B', 'admin'] || isSuperAdmin());
        
        // Admins and creators can delete messages
        allow delete: if isDraftAdmin(draftId);
      }

      // -----------------------------------------
      // SPECTATOR CHAT SUBCOLLECTION (Free For All)
      // -----------------------------------------
      match /chatSpectators/{messageId} {
        // Only spectators and admins can read, participants are specifically blocked
        allow read: if isAuthenticated() && 
                       (!(getRole(draftId) in ['A', 'B']) || isSuperAdmin());
        
        // Only real logged-in users (non-anonymous) and admins can send messages
        allow create: if isRealUser() &&
                         (!(getRole(draftId) in ['A', 'B']) || isSuperAdmin()) &&
                         request.resource.data.senderUid == request.auth.uid;
        
        // Spectators/Admins can update messages (for reactions)
        allow update: if isAuthenticated() && 
                         (!(getRole(draftId) in ['A', 'B']) || isSuperAdmin());
        
        // Admins and creators can delete messages
        allow delete: if isDraftAdmin(draftId);
      }
      
      // -----------------------------------------
      // TYPING INDICATOR SUBCOLLECTIONS
      // -----------------------------------------
      match /typingA/{odId} {
        allow read: if isAuthenticated() && 
                       (getRole(draftId) in ['A', 'admin'] || isSuperAdmin());
        allow write: if isAuthenticated() && 
                        (getRole(draftId) in ['A', 'admin'] || isSuperAdmin());
        allow delete: if isDraftAdmin(draftId);
      }
      
      match /typingB/{odId} {
        allow read: if isAuthenticated() && 
                       (getRole(draftId) in ['B', 'admin'] || isSuperAdmin());
        allow write: if isAuthenticated() && 
                        (getRole(draftId) in ['B', 'admin'] || isSuperAdmin());
        allow delete: if isDraftAdmin(draftId);
      }
      
      match /typingAll/{odId} {
        allow read: if isAuthenticated() && 
                       (getRole(draftId) in ['A', 'B', 'admin'] || isSuperAdmin());
        allow write: if isAuthenticated() && 
                        (getRole(draftId) in ['A', 'B', 'admin'] || isSuperAdmin());
        allow delete: if isDraftAdmin(draftId);
      }

      match /typingSpectators/{odId} {
        allow read: if isAuthenticated() && 
                       (!(getRole(draftId) in ['A', 'B']) || isSuperAdmin());
        allow write: if isRealUser() &&
                        (!(getRole(draftId) in ['A', 'B']) || isSuperAdmin());
        allow delete: if isDraftAdmin(draftId);
      }
    }
    
    // =============================================
    // USERS COLLECTION
    // =============================================
    match /users/{userId} {
      // Public read (to show participants in tournaments)
      allow read: if true;
      
      // Users can create and update their own data
      // Protect sensitive fields: role, tier, referralCode, referredBy, referralBonusClaimed,
      // referralCount, validReferralCount, points — these can only be changed by Admin SDK (cloud functions)
      // The 'role' field is additionally protected so only Super Admins can change it.
      allow create: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) && (
                         // Protect role field
                         (!('role' in request.resource.data) || (request.resource.data.role == resource.data.role)) &&
                         // Protect tier/referral/points fields from client-side writes
                         (!('tier' in request.resource.data) || (request.resource.data.tier == resource.data.get('tier', 1))) &&
                         (!('referralCode' in request.resource.data) || (request.resource.data.referralCode == resource.data.get('referralCode', ''))) &&
                         (!('referredBy' in request.resource.data) || (request.resource.data.referredBy == resource.data.get('referredBy', ''))) &&
                         (!('referralBonusClaimed' in request.resource.data) || (request.resource.data.referralBonusClaimed == resource.data.get('referralBonusClaimed', false))) &&
                         (!('referralCount' in request.resource.data) || (request.resource.data.referralCount == resource.data.get('referralCount', 0))) &&
                         (!('validReferralCount' in request.resource.data) || (request.resource.data.validReferralCount == resource.data.get('validReferralCount', 0))) &&
                         // Allow points deduction (purchase) OR increment up to 60000 (rewards)
                         (
                           !('points' in request.resource.data) || 
                           request.resource.data.points <= resource.data.get('points', 0) + 60000
                         ) &&
                         (!('ownedCosmetics' in request.resource.data) || request.resource.data.ownedCosmetics.size() >= resource.data.get('ownedCosmetics', []).size())
                       )) || (isAdmin() && (
                         !('role' in request.resource.data) || 
                         (request.resource.data.role == resource.data.role) ||
                         isSuperAdmin() ||
                         (!(resource.data.get('role', 'user') in ['admin', 'superadmin']) && (request.resource.data.get('role', 'user') in ['user', 'blocked', null]))
                       )) || (isAuthenticated() && (
                         // Allow authenticated users to increment another user's points for cosmetic commissions
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points']) &&
                         request.resource.data.points >= resource.data.get('points', 0)
                       ));

      // Subcollection: Points History
      match /pointsHistory/{historyId} {
        // Users can read their own points history, admins can read all
        allow read: if isOwner(userId) || isAdmin();
        // Users can create their own points history entries (for rewarding via transaction)
        allow create: if isOwner(userId) || isAdmin() || (
          isAuthenticated() && 
          request.resource.data.type in ['cosmetic_commission', 'cosmetic_purchase']
        );
        // Points history is immutable
        allow update, delete: if isAdmin();
      }

      // Subcollection: Mini-Game History
      match /miniGameHistory/{historyId} {
        // Users can read their own history, admins and games managers can read all
        allow read: if isOwner(userId) || isAdmin() || isGamesManager();
        // Users can create their own history entries
        allow create: if isOwner(userId) || isAdmin();
        // History is immutable
        allow update, delete: if isAdmin();
      }
      
      // Subcollection: Prizes (from events)
      match /prizes/{prizeId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isAdmin();
      }

      // Subcollection: Yggdrasil Data (Runes, Upgrades)
      match /yggdrasil_data/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Subcollection: Active Mini-Game Session Persistence
      match /activeSessions/{sessionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Subcollection: Rune Shop History
      match /rune_history/{historyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isAdmin();
      }

      // Only Super Admins can delete users
      allow delete: if isSuperAdmin();
    }

    // =============================================
    // PROFILE SOCIAL INTERACTIONS
    // =============================================
    match /profileInteractions/{targetUid} {
      // Anyone can read profile stats (likes/comment count)
      allow read: if true;
      
      // Creating or updating interaction stats (likes, counts)
      // Restricted to linked accounts only
      allow create, update: if isLinked();
      
      // Allow specific subcollection matches
      match /comments/{commentId} {
        // Anyone can read comments
        allow read: if true;
        
        // Only linked accounts can post comments
        allow create: if isLinked() && 
                         request.resource.data.authorUid == request.auth.uid;
        
        // Only authors or staff can delete comments
        allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);
        
        // Comments are generally immutable
        allow update: if isAdmin();
      }
    }

    // Notifications subcollection (Dedicated match for clarity)
    match /users/{userId}/notifications/{notifId} {
      // Users can read, update (mark as read), and delete their own notifications
      allow read, update, delete: if isOwner(userId) || isAdmin();

      
      // Allow any logged-in user to create notifications 
      // This is necessary so admins can invite other users
      allow create: if isAuthenticated();
    }
    
    // =============================================
    // WALLETS
    // =============================================
    match /wallets/{walletId} {
      // Users can read their own wallet, admins can read all
      // Authenticated users can read balances to verify during join transactions
      allow read: if isOwner(walletId) || isAdmin() || isAuthenticated();

      // Users can create their own wallet
      allow create: if isOwner(walletId) || isAdmin();

      // Users can update their own wallet ONLY if balances (AURY or USDC) are decreasing or staying same
      // This allows the client to deduct fees but prevents balance manipulation
      // Exception: allow authenticated users to increase balance for cosmetic commissions
      allow update: if (isOwner(walletId) || isAuthenticated()) &&
                       (
                         (request.resource.data.balance <= resource.data.balance &&
                          request.resource.data.get('usdcBalance', 0) <= resource.data.get('usdcBalance', 0)) ||
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'usdcBalance', 'updatedAt']) && 
                          (request.resource.data.balance >= resource.data.balance || request.resource.data.get('usdcBalance', 0) >= resource.data.get('usdcBalance', 0)))
                       );

      // Admins can update any wallet (for deposits, refunds, etc.)
      // Restricted to Super Admins for manual credit/deduction
      allow update: if isAdmin();


      // No one can delete wallets
      allow delete: if false;

      // Subcollection: Transactions
      match /transactions/{transactionId} {
        // Users can read their own transactions, admins can read all
        allow read: if isOwner(walletId) || isAdmin();

        // Users and admins can create transactions
        // Also allow authenticated users to create commission/revenue transactions for other users
        allow create: if isOwner(walletId) || isAdmin() || (
          isAuthenticated() && 
          request.resource.data.type in ['cosmetic_revenue', 'cosmetic_purchase']
        );


        // Transactions are immutable (no updates)
        allow update: if false;
        
        // Only Super Admins can delete transaction history
        allow delete: if isSuperAdmin();
      }
    }
    
    // =============================================
    // TRANSACTION COLLECTION GROUP (For Admin Economy Dashboard)
    // =============================================
    match /{path=**}/transactions/{transactionId} {
      allow read: if isAdmin();
    }
    
    // =============================================
    // WITHDRAWALS
    // =============================================
    match /withdrawals/{withdrawalId} {
      // Admins can read all withdrawals
      allow read: if isAdmin();
      
      // Users can also read their own withdrawals
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      
      // Only admins can update withdrawal status
      allow update: if isAdmin();
      
      // Only admins can delete withdrawals
      allow delete: if isAdmin();

    }
    
    // =============================================
    // DEPOSIT NOTIFICATIONS (THE CRITICAL ONE!)
    // =============================================
    match /depositNotifications/{notificationId} {
      // ADMINS CAN READ ALL NOTIFICATIONS
      allow read: if isAdmin();
      
      // Users can read their own notifications
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      
      // Only admins can update notifications (mark as processed)
      allow update: if isAdmin();
      
      // Only admins can delete notifications
      allow delete: if isAdmin();
    }

    // =============================================
    // BANNERS
    // =============================================
    match /banners/{bannerId} {
      // Anyone can read banners
      allow read: if true;
      
      // Only admins can manage banners
      allow write: if isAdmin();
    }

    // =============================================
    // CHATBOT KNOWLEDGE
    // =============================================
    match /chatbot_knowledge/{knowledgeId} {
      // Anyone can read knowledge items (so Runie can fetch responses)
      allow read: if true;
      
      // Only admins can manage knowledge base
      allow write: if isAdmin();
    }

    match /chatbot_greetings/{greetingId} {
      // Anyone can read floating greetings
      allow read: if true;
      
      // Only admins/system staff can manage greetings
      allow create, update, delete: if isAdmin();
    }

    match /chatbot_unanswered/{queryId} {
      // Admins manage the pool of queries
      allow read, delete: if isAdmin();
      
      // Anyone can log a query they had no answer for
      allow create: if true;
      
      // Logs are immutable
      allow update: if false;
    }

    // =============================================
    // NEWS
    // =============================================
    match /news/{newsId} {
      // Anyone can read news
      allow read: if true;
      
      // Only admins can create news
      allow create: if isAdmin();
      
      // Admins can update/delete their own news, Super Admins can update/delete any
      // Also allow any user to increment the viewCount
      allow delete: if isSuperAdmin() || 
                       (isAdmin() && resource.data.authorUid == request.auth.uid);
      allow update: if isSuperAdmin() || 
                       (isAdmin() && resource.data.authorUid == request.auth.uid) ||
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']));
    }

    // =============================================
    // REWARD LOGS
    // =============================================
    match /reward_logs/{logId} {
      // Admins can read all reward logs
      allow read: if isAdmin();
      
      // Only super admins can delete/clear logs
      allow delete: if isSuperAdmin();
      
      // Logs are immutable from the client
      allow write: if false;
    }

    // =============================================
    // ACTIVITY LOGS
    // =============================================
    match /activity_logs/{logId} {
      // Admins can read all logs
      allow read: if isAdmin();
      
      // Authenticated users can create logs (for tracking)
      allow create: if isAuthenticated();
      
      // Only super admins can delete/clear logs
      allow delete: if isSuperAdmin();
      
      // Logs are immutable
      allow update: if false;
    }

    // =============================================
    // SETTINGS (Global Announcements, etc.)
    // =============================================
    match /settings/{settingId} {
      // Anyone can read settings
      allow read: if true;
      
      // Only admins can manage settings, except mini_games which games_manager can also edit
      allow write: if isAdmin() || (isGamesManager() && settingId == 'mini_games');
    }
    // MATCHUPS
    // =============================================
    match /matchups/{matchupId} {
      // Anyone can read matchups
      allow read: if true;
      
      // Only admins can manage matchups (create/delete)
      allow create: if isAdmin();
      allow delete: if isAdmin();
      
      // Update logic for joining, leaving, starting, and reporting results
      allow update: if isAdmin() || (
        isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('auroryPlayerId', null) != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'participantUids']) &&
        request.resource.data.get('participantUids', []).size() <= resource.data.get('maxParticipants', 8) * 3 &&
        (
          // Join case: User is now in participantUids but wasn't before
          (request.auth.uid in request.resource.data.get('participantUids', []) &&
           !(request.auth.uid in resource.data.get('participantUids', []))) ||
          // Leave case: User is no longer in participantUids but was before
          (!(request.auth.uid in request.resource.data.get('participantUids', [])) &&
           request.auth.uid in resource.data.get('participantUids', []))
        )
      );
    }

    // =============================================
    // RAFFLES
    // =============================================
    match /raffles/{raffleId} {
      // Anyone can read raffles
      allow read: if true;
      
      // Only admins can create/delete raffles
      allow create, delete: if isAdmin();
      
      // Admins can update everything, users can only update the participants list to join
      allow update: if isAdmin() || (
        isAuthenticated() && 
        // 1. Must have a linked Aurory account
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('auroryPlayerId', null) != null &&
        // 2. Only specific fields can be touched
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'participantsCount', 'totalFeesCollected', 'updatedAt']) &&
        // 3. Exactly one participant added
        request.resource.data.participants.size() == resource.data.participants.size() + 1 &&
        // 4. Added participant must be the current user
        request.resource.data.participants[resource.data.participants.size()].uid == request.auth.uid &&
        // 5. Participants count must increment by 1
        request.resource.data.participantsCount == resource.data.participantsCount + 1 &&
        // 6. Total fees collected must increase by the correct amount (entryFee * multiplier)
        checkRaffleFee(resource.data, request.resource.data)
      );

      // Raffle Chat sub-collection
      match /chatAll/{messageId} {
        // Anyone can read the FFA chat
        allow read: if true;
        
        // Only real users with linked accounts can send messages
        allow create: if isRealUser() && 
                         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('auroryPlayerId', null) != null &&
                         request.resource.data.senderUid == request.auth.uid;
        
        // Members and admins can update messages (for reactions)
        allow update: if isAuthenticated() && 
                         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('auroryPlayerId', null) != null;
        
        // Admins can delete any message
        allow delete: if isAdmin();
      }

      // Typing indicators for Raffle
      match /typingAll/{typingId} {
        allow read: if true;
        allow write: if isRealUser() && 
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('auroryPlayerId', null) != null;
        allow delete: if isAdmin();
      }
    }
    // =============================================
    // YGGDRASIL EVENTS
    // =============================================
    match /yggdrasil_events/{eventId} {
      // Anyone can read events (to see what's available in the game)
      allow read: if true;
      
      // Only admins can create or delete events
      allow create, delete: if isAdmin();
      
      // Update rules:
      // 1. Admins can update anything.
      // 2. Authenticated users can increment currentPool via transactions/cloud functions.
      // 3. Authenticated users can claim the prize (handled via Cloud Function but rules should allow the read/check).
      allow update: if isAdmin() || (
        isAuthenticated() && (
          // Allow incrementing pool (joining)
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentPool']) ||
          // Allow claiming (this is usually handled by cloud functions, but we add safety here)
          (resource.data.status == 'open' && request.resource.data.status == 'closed' && request.resource.data.winnerId == request.auth.uid)
        )
      );
    }

    // =============================================
    // ODIN'S RIDDLE
    // =============================================
    match /riddles/{riddleId} {
      // Anyone can read riddles (for the minigame)
      allow read: if true;
      
      // Only admins can modify riddles
      allow write: if isAdmin();
    }

    // =============================================
    // COLLECTION GROUP RULES
    // =============================================
    // These allow collectionGroup() queries to function across multiple user subcollections
    match /{path=**}/miniGameHistory/{historyId} {
      allow read: if isAdmin() || isGamesManager();
    }
    
    match /{path=**}/pointsHistory/{historyId} {
      allow read: if isAdmin();
    }
    // =============================================
    // COSMETICS
    // =============================================
    match /cosmetics/{cosmeticId} {
      // Anyone can read store items
      allow read: if true;
      
      // Anyone can update the saleCount (via transaction)
      allow update: if isAuthenticated() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saleCount']) &&
        request.resource.data.saleCount == resource.data.saleCount + 1
      ) || isAdmin() || (isMerchant() && resource.data.createdBy == request.auth.uid);

      // Only admins can create/delete the inventory
      // Merchants can manage their own items
      allow create: if isAdmin() || (isMerchant() && request.resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() || (isMerchant() && resource.data.createdBy == request.auth.uid);
    }
    
    // =============================================
    // COSMETIC SALES LOGS
    // =============================================
    match /cosmetic_sales/{saleId} {
      // Only admins can read the sales history
      // Merchants can read their own sales
      allow read: if isAdmin() || (isMerchant() && resource.data.creatorId == request.auth.uid);
      // Only admins can manage sales history (update/delete)
      // Anyone authenticated can create a sale record during purchase
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // =============================================
    // PRIZE CLAIMS
    // =============================================
    match /prize_claims/{claimId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
