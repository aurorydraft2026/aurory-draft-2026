{
  "rules": {
    "recentMiniGameWinners": {
      ".read": true,
      ".write": false,
      ".indexOn": ["timestamp"]
    },
    "drakkar_race": {
      ".read": true,
      ".write": false,
      "presence": {
        "$uid": {
          ".write": "auth != null && auth.uid == $uid"
        }
      },
      "history": {
        ".indexOn": ["timestamp"]
      },
      "pools": {
        ".read": true,
        ".write": "auth != null",
        "$shipId": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "leaderboards": {
      "earnings": {
        "$currency": {
          "$gameId": {
            "$timeframe": {
              ".read": true,
              ".indexOn": ["score"],
              "$dateKey": {
                ".read": true,
                ".indexOn": ["score"]
              }
            }
          }
        }
      }
    },
    "mini_games": {
      "jackpots": {
        ".read": true,
        ".write": false
      }
    },
    "yggdrasil": {
      "players": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid"
        }
      },
      "leaderboard": {
        ".read": "auth != null",
        "alltime": {
          ".indexOn": ["score"],
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        },
        "daily": {
          "$date": {
            ".indexOn": ["score"],
            "$uid": {
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        },
        "weekly": {
          "$weekId": {
            ".indexOn": ["score"],
            "$uid": {
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        }
      }
    }
  }
}
