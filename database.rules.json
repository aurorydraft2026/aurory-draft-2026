{
  "rules": {
    "recentMiniGameWinners": {
      ".read": true,
      ".write": false,
      ".indexOn": ["timestamp"]
    },
    "minigame_chats": {
      ".read": true,
      "$channelId": {
        "$messageId": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['uid', 'name', 'text', 'timestamp']) && newData.child('uid').val() == auth.uid"
        }
      }
    },
    "drakkar_race": {
      ".read": true,
      ".write": false,
      "presence": {
        "$uid": {
          ".write": "auth != null && auth.uid == $uid"
        }
      },
      "history": {
        ".indexOn": ["timestamp"]
      },
      "pools": {
        ".read": true,
        ".write": "auth != null",
        "$shipId": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "leaderboards": {
      "earnings": {
        "$currency": {
          "$gameId": {
            "$timeframe": {
              ".read": true,
              ".indexOn": ["score"],
              "$dateKey": {
                ".read": true,
                ".indexOn": ["score"]
              }
            }
          }
        }
      }
    },
    "mini_games": {
      "jackpots": {
        ".read": true,
        ".write": false
      },
      "presence": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },
    "yggdrasil": {
      "spirits": {
        ".read": true,
        "$spiritId": {
          ".write": "auth != null"
        }
      },
      "global_goal": {
        ".read": true,
        ".write": "auth != null"
      },
      "players": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid"
        }
      },
      "leaderboard": {
        ".read": "auth != null",
        "alltime": {
          ".indexOn": ["score"],
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        },
        "daily": {
          "$date": {
            ".indexOn": ["score"],
            "$uid": {
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        },
        "weekly": {
          "$weekId": {
            ".indexOn": ["score"],
            "$uid": {
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        },
        "monthly": {
          "$monthId": {
            ".indexOn": ["score"],
            "$uid": {
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        }
      },
      "leaderboard_runes": {
        ".read": "auth != null",
        "alltime": {
          ".indexOn": ["score"],
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        },
        "daily": {
          "$date": {
            ".indexOn": ["score"],
            "$uid": {
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        },
        "weekly": {
          "$weekId": {
            ".indexOn": ["score"],
            "$uid": {
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        },
        "monthly": {
          "$monthId": {
            ".indexOn": ["score"],
            "$uid": {
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        }
      }
    }
  }
}
